ActiveThorns = "
  ADMBaseX
  BoxInBox
  CarpetX
  IOUtil
  ODESolvers
  ParticleAHFinderX
  Subcycling
"

Cactus::presync_mode = "mixed-error"
Cactus::cctk_itlast = 2

CarpetX::xmin = -2.0
CarpetX::ymin = -2.0
CarpetX::zmin = -2.0
CarpetX::xmax = 2.0
CarpetX::ymax = 2.0
CarpetX::zmax = 2.0
CarpetX::ncells_x = 32
CarpetX::ncells_y = 32
CarpetX::ncells_z = 32
CarpetX::blocking_factor_x = 8
CarpetX::blocking_factor_y = 8
CarpetX::blocking_factor_z = 8
CarpetX::max_grid_size_x = 16
CarpetX::max_grid_size_y = 16
CarpetX::max_grid_size_z = 16
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.25
CarpetX::max_num_levels = 2
CarpetX::regrid_every = 1

BoxInBox::num_regions = 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = 2
BoxInBox::position_x_1 = 0.0
BoxInBox::position_y_1 = 0.0
BoxInBox::position_z_1 = 0.0
BoxInBox::radius_1 = [-1.0, 0.5]

ADMBaseX::initial_data = "Cartesian Minkowski"
ODESolvers::method = "RK4"

ParticleAHFinderX::active = yes
ParticleAHFinderX::verbose = yes
ParticleAHFinderX::num_surfaces = 1
ParticleAHFinderX::find_every = 1
ParticleAHFinderX::interpolation_order = 3
ParticleAHFinderX::solve_surfaces = no
ParticleAHFinderX::ntheta[0] = 16
ParticleAHFinderX::nphi[0] = 32
ParticleAHFinderX::initial_radius[0] = 0.625
ParticleAHFinderX::diagnostics_every = 1
ParticleAHFinderX::diagnostics_out_dir = "diagnostics"
ParticleAHFinderX::debug_tsv_every = 1
ParticleAHFinderX::debug_max_particles = 512
ParticleAHFinderX::particle_out_every = 1
ParticleAHFinderX::particle_out_dir = "particles"

IO::out_dir = $parfile
IO::parfile_write = "no"
CarpetX::out_metadata = no
