ActiveThorns = "
  ADMBaseX
  BoxInBox
  CarpetX
  IOUtil
  MovingBoxToy
  ODESolvers
  ParticleAHFinderX
  Subcycling
  TmunuBaseX
  Z4c
"

Cactus::presync_mode = "mixed-error"
Cactus::cctk_itlast = 260

CarpetX::xmin = -2.0
CarpetX::ymin = -2.0
CarpetX::zmin = -2.0
CarpetX::xmax = 2.0
CarpetX::ymax = 2.0
CarpetX::zmax = 2.0
CarpetX::periodic = yes
CarpetX::periodic_x = yes
CarpetX::periodic_y = yes
CarpetX::periodic_z = yes
CarpetX::ncells_x = 32
CarpetX::ncells_y = 32
CarpetX::ncells_z = 32
CarpetX::blocking_factor_x = 8
CarpetX::blocking_factor_y = 8
CarpetX::blocking_factor_z = 8
CarpetX::max_grid_size_x = 16
CarpetX::max_grid_size_y = 16
CarpetX::max_grid_size_z = 16
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.5
CarpetX::max_num_levels = 2
CarpetX::regrid_every = 2
CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no
# AMReX 26.09 defaults this portable capability flag to false even when
# Cray MPICH device-pointer support is enabled in the launch environment.
# CarpetX forwards this array as AMReX argc/argv. Element zero is the
# synthetic program name; assignments must begin at element one.
CarpetX::amrex_parameters[0] = "particleahfinderx"
CarpetX::amrex_parameters[1] = "amrex.use_gpu_aware_mpi=1"

# MovingBoxToy rotates this region through one full period in t=8.  The
# particle surface is fixed at x=0.7, so the finest box first encloses it,
# moves completely away, and then returns across the same interface.
BoxInBox::num_regions = 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = 2
BoxInBox::position_x_1 = 0.7
BoxInBox::position_y_1 = 0.0
BoxInBox::position_z_1 = 0.0
BoxInBox::radius_1 = [-1.0, 0.6]

ADMBaseX::initial_data = "Cartesian Minkowski"
ADMBaseX::initial_lapse = "one"
ADMBaseX::initial_shift = "zero"
ODESolvers::method = "RK4"

ParticleAHFinderX::active = yes
ParticleAHFinderX::verbose = yes
ParticleAHFinderX::num_surfaces = 1
ParticleAHFinderX::find_every = 1
ParticleAHFinderX::interpolation_order = 3
ParticleAHFinderX::solve_surfaces = no
ParticleAHFinderX::ntheta[0] = 8
ParticleAHFinderX::nphi[0] = 16
ParticleAHFinderX::initial_center_x[0] = 0.7
ParticleAHFinderX::initial_center_y[0] = 0.0
ParticleAHFinderX::initial_center_z[0] = 0.0
ParticleAHFinderX::initial_radius[0] = 0.15
ParticleAHFinderX::diagnostics_every = 1
ParticleAHFinderX::diagnostics_out_dir = "diagnostics"
ParticleAHFinderX::debug_tsv_every = 8
ParticleAHFinderX::debug_max_particles = 128
ParticleAHFinderX::particle_out_every = 8
ParticleAHFinderX::particle_out_dir = "particles"

IO::out_dir = $parfile
IO::parfile_write = "no"
CarpetX::out_metadata = no
